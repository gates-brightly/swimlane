#!/usr/bin/env bash
# swim: syntax 2
# Round: @ROUND@
# Job:   @JOB@
# After: @AFTER@
# Lane:  swim @N@    Written: 2026-10-09
#
# Goal:
#   Synthetic DAG node (@KIND@). No network, nothing destructive. Proves
#   ordering AND data flow: its value is sha256 over its parents' values, so
#   swim 99 can recompute the whole DAG and catch a node that read early.
#
# Steps:
#   0. Clear own marker; gate: each parent (@PARENTS_TXT@) finished, for this run, before this started
#   1. Simulated work (@DUR@s)
#   2. Gate: value = sha256("@N@|" + parents' values) -> nodes/@N@.val
#   z. E2E_FAIL toggle; on success write nodes/@N@.done
#
# Guard flags this round honours (flag: action, date, reason):
#   (none)
# Test toggle (not a guard): E2E_FAIL="3 41"  lanes that fail on purpose.
#
# 99-lane stress DAG: lanes 1-9 real work, 10-98 synthetic, 99 audit.
# Shared dir .scenario/dag/: run.id (swim 1), nodes/N.done, nodes/N.val.
#
# Part of the e2e scenario e2e/scenarios/dag99 (run: e2e/run.sh dag99).
# Never edit this file while it may be running: `swim status` first.
# Do not use `set -e`: failed checks keep going; only gates stop the round.

_swim_lib=$("${SWIM_BIN:-swim}" lib) || { echo "swim not found on PATH" >&2; exit 1; }
eval "$_swim_lib"
lane_init @N@

D=.scenario/dag
N=@N@
PARENTS="@AFTER@"
NODE_START=$(e2etool now)
export D N PARENTS NODE_START
mkdir -p "$D/nodes"
run "clear own marker and value" rm -f "$D/nodes/$N.done" "$D/nodes/$N.val"
stage check
@PARENT_CHECK@@RUN_ID@
export RUN_ID

stage change
run "simulated work (@DUR@s)" sleep @DUR@
gate "value from parents -> nodes/$N.val" e2etool node-value $PARENTS

stage verify
gate "simulated failure off (E2E_FAIL='${E2E_FAIL:-}')" bash -c 'case " ${E2E_FAIL:-} " in *" $N "*) echo "E2E_FAIL includes $N"; exit 1;; esac'
if ! any_failed; then
  gate "mark node done" bash -c 'printf "%s %s %s\n" "$RUN_ID" "$NODE_START" "$(e2etool now)" > "$D/nodes/.$N.tmp" && mv "$D/nodes/.$N.tmp" "$D/nodes/$N.done" && cat "$D/nodes/$N.done"'
fi

summary
